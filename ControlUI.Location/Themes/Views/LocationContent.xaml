<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:james="clr-namespace:Jamesnet.Wpf.Controls;assembly=Jamesnet.Wpf"
    xmlns:views="clr-namespace:ControlUI.Location.UI.Views"
    xmlns:units="clr-namespace:ControlUI.Location.UI.Units">
    <Style TargetType="{x:Type views:LocationContent}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:LocationContent}">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <james:JamesGrid Rows="Auto" Columns="Auto, *">
                            <Border Background="#444444"
                                    BorderBrush="#222222"
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Margin="6 4 6 4"
                                    HorizontalAlignment="Left"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <units:LocatorButton ActionType="Back"
                                                         ToolTip="Back"
                                                         Command="{Binding BackCommand}"/>
                                    <units:LocatorButton ActionType="Forward"
                                                         ToolTip="Forward"
                                                         Command="{Binding ForwardCommand}"/>
                                </StackPanel>
                            </Border>
                        </james:JamesGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>