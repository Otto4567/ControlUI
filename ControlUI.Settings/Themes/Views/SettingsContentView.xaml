<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:views="clr-namespace:ControlUI.Settings.UI.Views">
    <BooleanToVisibilityConverter x:Key="SaveFeedbackVisibility"/>
    <ControlTemplate x:Key="SettingsVerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="{DynamicResource PageBackgroundBrush}">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Margin="3,1">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="Grip" Background="{DynamicResource MutedForegroundBrush}" CornerRadius="4"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource PrimaryForegroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="MotionSettingsScroll" TargetType="{x:Type views:SettingsScrollViewer}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="False"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Width="14"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                       Template="{StaticResource SettingsVerticalScrollBar}"/>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="SettingsCategoryTemplate" TargetType="TabItem">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="14,8"
                    BorderBrush="Transparent" BorderThickness="1">
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentForegroundBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    <Style TargetType="{x:Type views:SettingsContentView}">
        <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SettingsContentView}">
                    <Border Background="{TemplateBinding Background}" Padding="16">
                        <Grid>
                        <DockPanel TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}">
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button Content="{DynamicResource TextSavePreferences}" Command="{Binding SaveSettingsCommand}"
                                        Padding="12,4" DockPanel.Dock="Right"/>
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            </DockPanel>
                            <TabControl TabStripPlacement="Top" Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                <TabControl.Template>
                                    <ControlTemplate TargetType="TabControl">
                                        <DockPanel KeyboardNavigation.TabNavigation="Local">
                                            <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="0,0,0,8"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once"/>
                                            </Border>
                                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </DockPanel>
                                    </ControlTemplate>
                                </TabControl.Template>
                                <TabItem Header="{DynamicResource TextMotion}" Template="{StaticResource SettingsCategoryTemplate}" MinWidth="120" MinHeight="40" Height="40" Margin="0,0,6,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                                    <Grid>
                                        <views:SettingsScrollViewer x:Name="MotionSettingsScroller" VerticalScrollBarVisibility="Auto"
                                                                    CanContentScroll="False" IsDeferredScrollingEnabled="False"
                                                                    Template="{StaticResource MotionSettingsScroll}">
                                            <StackPanel Margin="0,0,8,48">
                                                <TextBlock Text="Default MOT File" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <DockPanel Margin="0,0,0,8">
                                                    <Button DockPanel.Dock="Right" Content="Use Default" Command="{Binding UseDefaultMotCommand}"
                                                            Margin="6,0,0,0"/>
                                                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseMotCommand}"
                                                            Margin="6,0,0,0"/>
                                                    <TextBox Text="{Binding DisplayedMotPath, Mode=OneWay}" IsReadOnly="True"
                                                             ToolTip="{Binding DisplayedMotPath}" VerticalContentAlignment="Center"/>
                                                </DockPanel>
                                                <hc:PropertyGrid SelectedObject="{Binding MotionProperties}" MinTitleWidth="180"/>
                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Program Axes" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <ListBox ItemsSource="{Binding ProgramAxes}" SelectedItem="{Binding SelectedAxis, Mode=TwoWay}"
                                                                 DisplayMemberPath="Name" MaxHeight="230" MinHeight="48"/>
                                                        <Button Content="Add Axis" Command="{Binding AddAxisCommand}" Margin="0,6,0,0"/>
                                                        <Button Content="Remove Axis" Command="{Binding RemoveAxisCommand}" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding SelectedAxis.Name, StringFormat='Axis {0} settings', TargetNullValue='Axis settings'}"
                                                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <StackPanel DataContext="{Binding SelectedAxis}" Margin="0,2,0,8">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <UniformGrid Columns="2">
                                                                <StackPanel Margin="0,0,6,0">
                                                                    <TextBlock Text="Resolution (µm/pulse) *" Margin="0,0,0,4"/>
                                                                    <Border BorderThickness="1" CornerRadius="4">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsResolutionValid}" Value="False">
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBox Text="{Binding ResolutionInput, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AutomationProperties.Name="Resolution (µm/pulse)" AutomationProperties.IsRequiredForForm="True"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Margin="6,0,0,0">
                                                                    <TextBlock Text="Max speed (mm/s) *" Margin="0,0,0,4"/>
                                                                    <Border BorderThickness="1" CornerRadius="4">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsMaxSpeedValid}" Value="False">
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBox Text="{Binding MaxSpeedInput, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AutomationProperties.Name="Max speed (mm/s)" AutomationProperties.IsRequiredForForm="True"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </UniformGrid>
                                                                </StackPanel>
                                                        <hc:PropertyGrid SelectedObject="{Binding SelectedAxis}" MinTitleWidth="180"/>
                                                        <Expander Header="Board I/O and Homing" Margin="0,12,0,4" IsExpanded="True">
                                                            <StackPanel Margin="0,6,0,0">
                                                                <WrapPanel>
                                                                    <Button Content="Read Board" Command="{Binding ReadMotionBoardCommand}" Margin="0,0,6,0"/>
                                                                    <Button Content="Apply to Board" Command="{Binding ApplyMotionBoardCommand}"/>
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding MotionBoardSummary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                                <hc:PropertyGrid SelectedObject="{Binding MotionIo}" MinTitleWidth="240" Margin="0,6,0,0"/>
                                                                <TextBlock Text="{Binding MotionIoStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </views:SettingsScrollViewer>
                                        <hc:GotoTop Target="{Binding ElementName=MotionSettingsScroller}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,8"
                                                    ToolTip="{DynamicResource TextGoToTop}" AutomationProperties.Name="{DynamicResource TextGoToTop}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="System" Template="{StaticResource SettingsCategoryTemplate}" MinWidth="120" MinHeight="40" Height="40" Margin="0,0,6,0" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                                    <hc:PropertyGrid SelectedObject="{Binding SystemProperties}" MinTitleWidth="180" Margin="0,0,8,0"/>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                        <Border x:Name="SaveFeedbackBanner" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                Margin="-16,0" Padding="24,16" IsHitTestVisible="False"
                                Visibility="{Binding IsSaveFeedbackVisible, Converter={StaticResource SaveFeedbackVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#175B43"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSaveFeedbackError}" Value="True">
                                            <Setter Property="Background" Value="#942C38"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SaveFeedback}" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="820"
                                       FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
