<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:james="clr-namespace:Jamesnet.Wpf.Controls;assembly=Jamesnet.Wpf"
    xmlns:units="clr-namespace:ControlUI.Support.UI.Units">
    <Style TargetType="{x:Type units:DarkWindow}">
        <Setter Property="Background" Value="#202020"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#202020"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MinHeight" Value="200"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="35" 
                              CornerRadius="0" 
                              GlassFrameThickness="0"
                              NonClientFrameEdges="None" 
                              ResizeBorderThickness="5" 
                              UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:DarkWindow}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            UseLayoutRounding="{TemplateBinding UseLayoutRounding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <james:JamesGrid Rows="Auto, *"
                                         Columns="*, Auto, Auto, Auto, Auto">
                            <ContentPresenter ContentTemplate="{TemplateBinding LocationTemplate}"
                                              Content="{TemplateBinding Location}"/>
                            <units:TopmostButton ToolTip="Always on Top"
                                                 WindowChrome.IsHitTestVisibleInChrome="True"
                                                 Command="{Binding ToggleTopmostCommand}"
                                                 CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            <units:MinimizeButton ToolTip="Minimize"
                                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                                  Command="{Binding MinimizeCommand}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            <units:MaximizeButton ToolTip="Maximize"
                                                  WindowChrome.IsHitTestVisibleInChrome="True"
                                                  Command="{Binding ToggleMaximizeCommand}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            <units:CloseButton ToolTip="Close"
                                               WindowChrome.IsHitTestVisibleInChrome="True"
                                               Command="{Binding CloseCommand}"
                                               CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Grid.ColumnSpan="5" 
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentSource="Content"/>
                        </james:JamesGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>