<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:units="clr-namespace:ControlUI.Support.UI.Units">
    <Style TargetType="{x:Type units:DarkWindow}">
        <Setter Property="Background" Value="{DynamicResource ShellBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="MinWidth" Value="320"/>
        <Setter Property="MinHeight" Value="200"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="35"
                              GlassFrameThickness="0,40,0,0"
                              ResizeBorderThickness="5"
                              UseAeroCaptionButtons="True"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:DarkWindow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- Leave the system-drawn caption buttons unobstructed. -->
                            <ColumnDefinition Width="{Binding CaptionButtonReserve, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Background="{TemplateBinding Background}" Grid.Row="0" Grid.Column="0">
                            <ContentPresenter DockPanel.Dock="Left" VerticalAlignment="Center"
                                              ContentTemplate="{TemplateBinding LocationTemplate}"
                                              Content="{TemplateBinding Location}"/>
                            <units:TopmostButton x:Name="PinButton" DockPanel.Dock="Right" VerticalAlignment="Top"
                                                 Width="{Binding CaptionButtonSize.Width, RelativeSource={RelativeSource TemplatedParent}}"
                                                 Height="{Binding CaptionButtonSize.Height, RelativeSource={RelativeSource TemplatedParent}}"
                                                 Margin="{TemplateBinding CaptionButtonOffset}"
                                                 ToolTip="{DynamicResource TextAlwaysOnTop}"
                                                 AutomationProperties.Name="{DynamicResource TextAlwaysOnTop}"
                                                 WindowChrome.IsHitTestVisibleInChrome="True"
                                                 Command="{Binding ToggleTopmostCommand}"
                                                 CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            <TextBlock Text="{TemplateBinding Title}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DockPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="Content"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
