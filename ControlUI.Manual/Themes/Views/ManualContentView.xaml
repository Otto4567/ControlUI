                                                            <DataGridTextColumn Width="*" Binding="{Binding DelayMicroseconds, StringFormat={}{0:0.###}, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextDelayS}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                            <DataGridTextColumn Width="*" Binding="{Binding DurationMicroseconds, StringFormat={}{0:0.###}, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextDurationS}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                        </DataGrid.Columns>
