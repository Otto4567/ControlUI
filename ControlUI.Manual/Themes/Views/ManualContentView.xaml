<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:units="clr-namespace:ControlUI.Manual.UI.Units" xmlns:views="clr-namespace:ControlUI.Manual.UI.Views">
    <BooleanToVisibilityConverter x:Key="MotionBusyVisibility"/>
    <Style x:Key="ManualCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="ManualHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="AxisDisplay" TargetType="Border">
        <Setter Property="Background" Value="#101714"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style x:Key="AxisDigits" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#85E7AB"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="AxisState" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="2,4"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedForegroundBrush}"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="False">
                <Setter Property="ToolTip" Value="Off"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsActive}" Value="{x:Null}">
                <Setter Property="ToolTip" Value="Unavailable"/>
                <Setter Property="Opacity" Value="0.65"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="#196548"/>
                <Setter Property="TextElement.Foreground" Value="White"/>
                <Setter Property="ToolTip" Value="On"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AxisFault" TargetType="Border" BasedOn="{StaticResource AxisState}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="#9E3035"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="MotionAxisTemplate">
        <Border Style="{StaticResource ManualCard}" Padding="8" Margin="3,0,3,6">
            <StackPanel>
                <DockPanel Margin="3,0,3,4">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding MaxSpeedMillimetersPerSecond, StringFormat='Max {0:0.###} mm/s'}" ToolTip="{Binding SdkSettings}"/>
                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold"/>
                </DockPanel>
                <UniformGrid Columns="3">
                    <StackPanel Margin="3"><TextBlock Text="Command (mm)"/><Border Style="{StaticResource AxisDisplay}"><TextBlock Style="{StaticResource AxisDigits}" Text="{Binding CommandPositionMm, StringFormat={}{0:0.0000}, TargetNullValue=—}"/></Border></StackPanel>
                    <StackPanel Margin="3"><TextBlock Text="Actual (mm)"/><Border Style="{StaticResource AxisDisplay}"><TextBlock Style="{StaticResource AxisDigits}" Text="{Binding ActualPositionMm, StringFormat={}{0:0.0000}, TargetNullValue=—}"/></Border></StackPanel>
                    <StackPanel Margin="3"><TextBlock Text="Speed (mm/s)"/><Border Style="{StaticResource AxisDisplay}"><TextBlock Style="{StaticResource AxisDigits}" Text="{Binding ActualVelocityMmPerSecond, StringFormat={}{0:0.0000}, TargetNullValue=—}"/></Border></StackPanel>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,2">
                    <Border Style="{StaticResource AxisState}" DataContext="{Binding ServoOn}"><TextBlock Text="Servo"/></Border>
                    <Border Style="{StaticResource AxisFault}" DataContext="{Binding Alarm}"><TextBlock Text="Alarm"/></Border>
                    <Border Style="{StaticResource AxisState}" DataContext="{Binding Moving}"><TextBlock Text="Moving"/></Border>
                    <Border Style="{StaticResource AxisState}" DataContext="{Binding Homed}"><TextBlock Text="Home End" ToolTip="Homing has completed"/></Border>
                    <Border Style="{StaticResource AxisFault}" DataContext="{Binding PositiveLimit}"><TextBlock Text="+Limit"/></Border>
                    <Border Style="{StaticResource AxisFault}" DataContext="{Binding NegativeLimit}"><TextBlock Text="−Limit"/></Border>
                <Border Style="{StaticResource AxisState}" DataContext="{Binding InPosition}"><TextBlock Text="In Position"/></Border>
                    <Border Style="{StaticResource AxisState}" DataContext="{Binding HomeSignal}"><TextBlock Text="Home Sig" ToolTip="Home sensor input is active"/></Border>
                    <Border Style="{StaticResource AxisFault}" DataContext="{Binding Emergency}"><TextBlock Text="Emergency Input"/></Border>
                </UniformGrid>
                <TextBlock Text="{Binding AlarmCode}" Foreground="{DynamicResource ErrorForegroundBrush}"
                           Margin="3,0" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AlarmCode}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <UniformGrid Columns="3" IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}">
                    <Button Content="Servo On" Margin="3" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ServoOnAxisCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"/>
                    <Button Content="Servo Off" Margin="3" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ServoOffAxisCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"/>
                    <Button Content="Reset Alarm" Margin="3" CommandParameter="{Binding}"
                            Command="{Binding DataContext.ResetAxisAlarmCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"/>
                </UniformGrid>
                <UniformGrid Columns="4">
                    <StackPanel Margin="3"><TextBlock Text="Target (mm)"/><hc:NumericUpDown Height="28" Increment="0.1" ValueFormat="0.##########" Value="{Binding TargetPositionMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Margin="3"><TextBlock Text="{DynamicResource TextVelocityMmS}"/><hc:NumericUpDown Height="28" Minimum="0" Increment="1" Value="{Binding VelocityMmPerSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Margin="3"><TextBlock Text="{DynamicResource TextAccelRate}"/><hc:NumericUpDown Height="28" Minimum="0" Increment="1" Value="{Binding AccelMmPerSecondSquared, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Margin="3"><TextBlock Text="{DynamicResource TextDecelRate}"/><hc:NumericUpDown Height="28" Minimum="0" Increment="1" Value="{Binding DecelMmPerSecondSquared, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                </UniformGrid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <units:JogButton IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" CommandParameter="{Binding}" ReleaseCommand="{Binding DataContext.ReleaseJogCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" Margin="3" Height="29" HorizontalAlignment="Stretch">
                        <units:JogButton.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{Binding FirstJogLabel}"/>
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                <Setter Property="Command" Value="{Binding DataContext.JogPositiveCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJogHorizontal}" Value="True">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="Grid.RowSpan" Value="2"/>
                                        <Setter Property="Grid.Column" Value="0"/>
                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFirstJogPositive}" Value="False">
                                        <Setter Property="Command" Value="{Binding DataContext.JogNegativeCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </units:JogButton.Style>
                    </units:JogButton>
                    <units:JogButton IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" CommandParameter="{Binding}" ReleaseCommand="{Binding DataContext.ReleaseJogCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" Margin="3" Height="29" HorizontalAlignment="Stretch">
                        <units:JogButton.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="{Binding SecondJogLabel}"/>
                                <Setter Property="Grid.Row" Value="1"/>
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                <Setter Property="Command" Value="{Binding DataContext.JogNegativeCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJogHorizontal}" Value="True">
                                        <Setter Property="Grid.Row" Value="0"/>
                                        <Setter Property="Grid.RowSpan" Value="2"/>
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFirstJogPositive}" Value="False">
                                        <Setter Property="Command" Value="{Binding DataContext.JogPositiveCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </units:JogButton.Style>
                    </units:JogButton>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Margin="3" Height="29" SelectedIndex="{Binding MoveModeIndex, Mode=TwoWay}" AutomationProperties.Name="Move Mode">
                        <ComboBoxItem Content="{DynamicResource TextAbsolute}"/>
                        <ComboBoxItem Content="{DynamicResource TextRelative}"/>
                    </ComboBox>
                    <Button Grid.Column="1" Content="{DynamicResource TextMove}" Margin="3" Height="29"
                            HorizontalAlignment="Stretch" IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" Command="{Binding DataContext.MoveAxisCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" CommandParameter="{Binding}"/>
                    <Button Grid.Column="2" Content="{DynamicResource TextHome}" Margin="3" Height="29"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"
                            Command="{Binding DataContext.HomeAxisCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}"
                            CommandParameter="{Binding}"/>
                </Grid>
                <UniformGrid Columns="2">
                    <Button Content="S-Stop" Margin="3" Height="29" HorizontalAlignment="Stretch" IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" Command="{Binding DataContext.SmoothStopCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" CommandParameter="{Binding}"
                            ToolTip="Decelerate using the current motion profile" ToolTipService.ShowOnDisabled="True"/>
                    <Button Content="E-Stop (Axis)" Margin="3" Height="29" HorizontalAlignment="Stretch" IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" Command="{Binding DataContext.AbruptStopCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" CommandParameter="{Binding}"
                            ToolTip="Request an abrupt stop of this axis" ToolTipService.ShowOnDisabled="True"/>
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,4,0,0">
                    <StackPanel Margin="3">
                        <TextBlock Text="Repeat Count"/>
                        <hc:NumericUpDown Height="28" Minimum="1" Maximum="2147483647" Increment="1" ValueFormat="0" Value="{Binding RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="3">
                        <TextBlock Text="Repeat Delay (ms)"/>
                        <hc:NumericUpDown Height="28" Minimum="0" Maximum="2147483647" Increment="100" ValueFormat="0" Value="{Binding RepeatDelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="2">
                    <Button Content="Start Repeat" Margin="3" Height="29" HorizontalAlignment="Stretch" IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" Command="{Binding DataContext.StartRepeatCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" CommandParameter="{Binding}"/>
                    <Button Content="Stop Repeat" Margin="3" Height="29" HorizontalAlignment="Stretch" IsEnabled="{Binding DataContext.IsMotionInitialized, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" Command="{Binding DataContext.StopRepeatCommand, RelativeSource={RelativeSource AncestorType={x:Type views:ManualContentView}}}" CommandParameter="{Binding}"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </DataTemplate>
    <Style x:Key="ManualTabHeader" TargetType="TabItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="HeaderSurface" Background="{DynamicResource PageBackgroundBrush}" Padding="18,8" Margin="0,0,2,0" BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <TextBlock Text="{TemplateBinding Header}" Foreground="{DynamicResource PrimaryForegroundBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource SelectionIndicatorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type views:ManualContentView}">
        <Setter Property="Background" Value="{DynamicResource PageBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:ManualContentView}">
                    <Border Background="{TemplateBinding Background}" Padding="16">
                        <TabControl Margin="10" Background="Transparent" Foreground="{DynamicResource PrimaryForegroundBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <TabItem Style="{StaticResource ManualTabHeader}" Header="{DynamicResource TextMotion}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.InputBindings>
                                        <KeyBinding Key="Escape" Command="{Binding StopAllCommand}"/>
                                    </Grid.InputBindings>
                                    <Border Style="{StaticResource ManualCard}" TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                                    <Button Content="Servo On All" Command="{Binding ServoOnAllCommand}" IsEnabled="{Binding IsMotionInitialized}" Margin="0,2,6,2"/>
                                                    <Button Content="Servo Off All" Command="{Binding ServoOffAllCommand}" IsEnabled="{Binding IsMotionInitialized}" Margin="0,2,6,2"/>
                                                    <Button Content="Home All" Command="{Binding HomeAllCommand}" IsEnabled="{Binding IsMotionInitialized}" Margin="0,2,8,2"/>
                                                    <Button Content="Stop All (Esc)" Command="{Binding StopAllCommand}" IsEnabled="{Binding IsMotionInitialized}"
                                                            Margin="0,2,8,2" MinWidth="100" Background="#9B6308" Foreground="White"
                                                            ToolTip="Request a deceleration stop for all configured axes"/>
                                                    <Button Content="E-Stop All" Command="{Binding EmergencyStopAllCommand}" IsEnabled="{Binding IsMotionInitialized}"
                                                            Margin="0,2,0,2" MinWidth="100" Background="#A92D35" Foreground="White"
                                                            ToolTip="Request an abrupt software stop for all configured axes"/>
                                                </StackPanel>
                                                <WrapPanel>
                                                <TextBlock Text="SIMULATION" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource WarningForegroundBrush}"
                                                           Visibility="{Binding IsSimulation, Converter={StaticResource MotionBusyVisibility}}"/>
                                                <Button Content="{DynamicResource TextInitialize}" Margin="0,2,4,2" Command="{Binding InitializeMotionCommand}" />
                                                <hc:SplitButton Content="{DynamicResource TextLoadMot}" Margin="0,2,4,2"
                                                                Command="{Binding LoadMotionParametersCommand}">
                                                    <hc:SplitButton.DropDownContent>
                                                        <StackPanel>
                                                            <MenuItem Header="{DynamicResource TextSaveAs}" Command="{Binding SaveMotionParametersCommand}"/>
                                                        </StackPanel>
                                                    </hc:SplitButton.DropDownContent>
                                                </hc:SplitButton>
                                                <Button Content="Motion Settings" Margin="0,2,4,2" Command="{Binding OpenMotionSettingsCommand}"/>
                                                <TextBlock VerticalAlignment="Center" Margin="8,0" Text="{Binding MotionParameterFileName}" ToolTip="{Binding MotionParameterPath}" />
                                                </WrapPanel>
                                            </DockPanel>
                                            <Border Margin="0,4,0,0" Width="170" HorizontalAlignment="Left" Padding="8,6" MinHeight="42" CornerRadius="6"
                                                    AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#424956"/>
                                                        <Setter Property="Tag" Value="{DynamicResource TextOFFLINE}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MainStatus}" Value="Standby">
                                                                <Setter Property="Background" Value="#405570"/>
                                                                <Setter Property="Tag" Value="{DynamicResource TextMainStatusStandby}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MainStatus}" Value="Ready">
                                                                <Setter Property="Background" Value="#17644F"/>
                                                                <Setter Property="Tag" Value="{DynamicResource TextMainStatusReady}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MainStatus}" Value="Busy">
                                                                <Setter Property="Background" Value="#245493"/>
                                                                <Setter Property="Tag" Value="{DynamicResource TextMainStatusBusy}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MainStatus}" Value="Running">
                                                                <Setter Property="Background" Value="#17644F"/>
                                                                <Setter Property="Tag" Value="{DynamicResource TextMainStatusRunning}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MainStatus}" Value="Stopping">
                                                                <Setter Property="Background" Value="#9A4719"/>
                                                                <Setter Property="Tag" Value="{DynamicResource TextMainStatusStopping}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MainStatus}" Value="Stopped">
                                                                <Setter Property="Background" Value="#8C2835"/>
                                                                <Setter Property="Tag" Value="{DynamicResource TextMainStatusStopped}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding MainStatus}" Value="Fault">
                                                                <Setter Property="Background" Value="#8C2835"/>
                                                                <Setter Property="Tag" Value="{DynamicResource TextMainStatusFault}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}"
                                                           Foreground="White" FontSize="20" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding MotionStatus}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <hc:LoadingLine Height="4" IsRunning="{Binding IsMotionBusy}" Visibility="{Binding IsMotionBusy, Converter={StaticResource MotionBusyVisibility}}" Foreground="{DynamicResource AccentForegroundBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" x:Name="MotionScroll" VerticalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}">
                                        <ItemsControl ItemsSource="{Binding MotionAxes}" ItemTemplate="{StaticResource MotionAxisTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding DataContext.AxisColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <hc:GotoTop Grid.Row="1" Target="{Binding ElementName=MotionScroll}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" ToolTip="{DynamicResource TextGoToTop}" />
                                </Grid>
                            </TabItem>
                            <TabItem Style="{StaticResource ManualTabHeader}" Header="{DynamicResource TextTrigger}">
                                <Grid>
                                    <ScrollViewer x:Name="TriggerScroll" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Border Style="{StaticResource ManualCard}">
                                                <TextBlock Text="{DynamicResource TextSYNEXET2022Disconnected}" />
                                            </Border>
                                            <Border Style="{StaticResource ManualCard}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TextTriggerParameters}" Style="{StaticResource ManualHeading}" />
                                                    <WrapPanel>
                                                        <StackPanel Width="144" Margin="0,0,12,12">
                                                            <TextBlock Text="{DynamicResource TextStart}" Margin="0,0,0,4" />
                                                            <hc:NumericUpDown IsEnabled="False" />
                                                        </StackPanel>
                                                        <StackPanel Width="144" Margin="0,0,12,12">
                                                            <TextBlock Text="{DynamicResource TextEnd}" Margin="0,0,0,4" />
                                                            <hc:NumericUpDown IsEnabled="False" />
                                                        </StackPanel>
                                                        <StackPanel Width="144" Margin="0,0,12,12">
                                                            <TextBlock Text="{DynamicResource TextScanDirection}" Margin="0,0,0,4" />
                                                            <ComboBox IsEnabled="False">
                                                                <ComboBoxItem Content="{DynamicResource TextIncrement}" />
                                                                <ComboBoxItem Content="{DynamicResource TextDecrement}" />
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Width="144" Margin="0,0,12,12">
                                                            <TextBlock Text="{DynamicResource TextEncoderInput}" Margin="0,0,0,4" />
                                                            <ComboBox IsEnabled="False">
                                                                <ComboBoxItem Content="{DynamicResource TextEncoder}" />
                                                                <ComboBoxItem Content="TTL" />
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <DataGrid ItemsSource="{Binding TriggerChannels}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource TableGridLineBrush}" VerticalGridLinesBrush="{DynamicResource TableGridLineBrush}" MinColumnWidth="78" RowHeight="30" ColumnHeaderHeight="34" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Width="Auto" Binding="{Binding Channel, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextChannel}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                            <DataGridTextColumn Width="*" Binding="{Binding IsEnabled, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextEnabled}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                            <DataGridTextColumn Width="*" Binding="{Binding IntervalCounts, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextIntervalCount}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                            <DataGridTextColumn Width="*" Binding="{Binding DelayTicks, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextDelay100Ns}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                            <DataGridTextColumn Width="*" Binding="{Binding PulseWidthTicks, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextPulseWidth100Ns}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                            <DataGridTextColumn Width="*" Binding="{Binding Polarity, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextPolarity}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                            <DataGridTextColumn Width="*" Binding="{Binding OutputCount, TargetNullValue=—}"><DataGridTextColumn.Header><TextBlock Text="{DynamicResource TextOutputCount}"/></DataGridTextColumn.Header></DataGridTextColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource ManualCard}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TextMonitorAndControl}" Style="{StaticResource ManualHeading}" />
                                                    <TextBlock Text="{DynamicResource TextEncoderPositionCH1CountCH2Count}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                                    <WrapPanel>
                                                        <Button Content="{DynamicResource TextApply}" IsEnabled="False" Margin="0,4,8,0" Padding="12,4" />
                                                        <Button Content="{DynamicResource TextGo}" IsEnabled="False" Margin="0,4,8,0" Padding="12,4" />
                                                        <Button Content="{DynamicResource TextStop}" IsEnabled="False" Margin="0,4,8,0" Padding="12,4" />
                                                        <Button Content="{DynamicResource TextResetCount}" IsEnabled="False" Margin="0,4,8,0" Padding="12,4" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <hc:GotoTop Target="{Binding ElementName=TriggerScroll}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" ToolTip="{DynamicResource TextGoToTop}" />
                                </Grid>
                            </TabItem>
                            <TabItem Style="{StaticResource ManualTabHeader}" Header="{DynamicResource TextLighting}">
                                <Grid>
                                    <ScrollViewer x:Name="LightingScroll" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,12,0,0" TextElement.Foreground="{DynamicResource PrimaryForegroundBrush}">
                                            <Border Style="{StaticResource ManualCard}">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource TextConnection}" Style="{StaticResource ManualHeading}" />
