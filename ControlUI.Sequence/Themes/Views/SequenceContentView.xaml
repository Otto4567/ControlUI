<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ControlUI.Sequence.UI.Views">

    <Style TargetType="{x:Type views:SequenceContentView}">
        <Setter Property="Background" Value="#39301E"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SequenceContentView}">
                    <Border Background="{TemplateBinding Background}">
                        <TextBlock
                            Text="Sequence Test"
                            Foreground="White"
                            FontSize="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>