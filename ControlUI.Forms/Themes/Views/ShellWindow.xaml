<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:based="clr-namespace:ControlUI.Support.UI.Units;assembly=ControlUI.Support"
    xmlns:views="clr-namespace:ControlUI.Forms.UI.Views"
    xmlns:units="clr-namespace:ControlUI.Forms.UI.Units">
    <Style 
        TargetType="{x:Type views:ShellWindow}" 
        BasedOn="{StaticResource {x:Type based:DarkWindow}}">
        <Setter Property="Content">
            <Setter.Value>
                <StackPanel>
                    <TextBlock Text="{Binding}" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding DownloadDirectory}"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding DocumentsDirectory}"
                               Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding PicturesDirectory}"
                               Foreground="#FFFFFF"/>
                    <units:FolderTreeView>
                        <units:FolderTreeItem Header="dimohy"/>
                        <units:FolderTreeItem Header="vincent"/>
                        <units:FolderTreeItem Header="rkttu"/>
                    </units:FolderTreeView>
                </StackPanel>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>