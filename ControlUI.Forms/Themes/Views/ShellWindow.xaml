<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:james="clr-namespace:Jamesnet.Wpf.Controls;assembly=Jamesnet.Wpf"
    xmlns:based="clr-namespace:ControlUI.Support.UI.Units;assembly=ControlUI.Support"
    xmlns:views="clr-namespace:ControlUI.Forms.UI.Views">
    <Style 
        TargetType="{x:Type views:ShellWindow}" 
        BasedOn="{StaticResource {x:Type based:DarkWindow}}">
        <Setter Property="Title" Value="ControlUI"/>
        <Setter Property="Width" Value="1440"/>
        <Setter Property="Height" Value="960"/>
        <Setter Property="SizeToContent" Value="Manual"/>
        <Setter Property="Location">
            <Setter.Value>
                <james:JamesRegion RegionName="LocationRegion"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Content">
            <Setter.Value>
                <james:JamesRegion RegionName="MainRegion"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
