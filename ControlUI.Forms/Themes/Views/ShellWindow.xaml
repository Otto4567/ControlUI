<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:based="clr-namespace:ControlUI.Support.UI.Units;assembly=ControlUI.Support"
    xmlns:views="clr-namespace:ControlUI.Forms.UI.Views">
    <Style 
        TargetType="{x:Type views:ShellWindow}" 
        BasedOn="{StaticResource {x:Type based:DarkWindow}}">
        <Setter Property="Content">
            <Setter.Value>
                <TextBlock 
                    Text="Window Content!" 
                    Foreground="#FFFFFF"
                    Margin="10"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>