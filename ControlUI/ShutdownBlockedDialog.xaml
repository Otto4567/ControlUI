<Window x:Class="ControlUI.ShutdownBlockedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource TextShutdownBlocked}" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}" Foreground="{DynamicResource PrimaryForegroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=KeepOpen}">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource TextForceExitExplanation}" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="140" Margin="0,10" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="FailureReason" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="KeepOpen" Content="{DynamicResource TextKeepOpen}" IsDefault="True"
                    IsCancel="True" Click="KeepOpen_Click" Margin="0,0,8,0" />
            <Button x:Name="ForceExit" Content="{DynamicResource TextForceExit}" Click="ForceExit_Click" />
        </StackPanel>
    </StackPanel>
</Window>
