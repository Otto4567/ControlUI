<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:based="clr-namespace:ControlUI.Support.UI.Units;assembly=ControlUI.Support"
    xmlns:units="clr-namespace:ControlUI.Main.UI.Units">
    <Style TargetType="{x:Type units:FileListBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:FileListBox}">
                    <based:DarkScrollViewer HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </based:DarkScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>