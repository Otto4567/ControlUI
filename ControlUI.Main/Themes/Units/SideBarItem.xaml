<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:james="clr-namespace:Jamesnet.Wpf.Controls;assembly=Jamesnet.Wpf"
    xmlns:units="clr-namespace:ControlUI.Main.UI.Units">

    <Style TargetType="{x:Type units:SideBarItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B8BEC8"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="ToolTip" Value="{Binding Title}"/>
        <Setter Property="ToolTipService.Placement" Value="Right"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:SideBarItem}">
                    <Border
                        x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <!-- 선택 표시 -->
                            <Border
                                x:Name="SelectionMark"
                                Width="3"
                                Margin="0,10,0,10"
                                HorizontalAlignment="Left"
                                Background="#69B4FF"
                                CornerRadius="1"
                                Visibility="Collapsed"/>

                            <!-- 메뉴 아이콘 -->
                            <james:JamesIcon
                                Width="20"
                                Height="20"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Icon="{Binding Icon}"
                                Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#30343A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#253B50"/>
                            <Setter Property="Foreground" Value="#85C5FF"/>
                            <Setter
                                TargetName="SelectionMark"
                                Property="Visibility"
                                Value="Visible"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#85C5FF"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter
                                TargetName="ItemBorder"
                                Property="Opacity"
                                Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>