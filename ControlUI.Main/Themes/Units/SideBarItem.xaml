<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:james="clr-namespace:Jamesnet.Wpf.Controls;assembly=Jamesnet.Wpf"
    xmlns:units="clr-namespace:ControlUI.Main.UI.Units">

    <Style TargetType="{x:Type units:SideBarItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B8BEC8"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:SideBarItem}">
                    <Border
                        x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <!-- 選択中の印 -->
                            <Border
                                x:Name="SelectionMark"
                                Width="3"
                                Margin="0,10,0,10"
                                HorizontalAlignment="Left"
                                Background="#69B4FF"
                                CornerRadius="1"
                                Visibility="Collapsed"/>

                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <james:JamesIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Icon="{Binding Icon}"
                                    Fill="{TemplateBinding Foreground}"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Title}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="14"
                                    TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#30343A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- 마우스 오버보다 뒤에 두어 선택 색상을 유지 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#253B50"/>
                            <Setter Property="Foreground" Value="#85C5FF"/>
                            <Setter
                                TargetName="SelectionMark"
                                Property="Visibility"
                                Value="Visible"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="#85C5FF"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter
                                TargetName="ItemBorder"
                                Property="Opacity"
                                Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>