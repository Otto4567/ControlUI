<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ControlUI.Main.UI.Views"
    xmlns:units="clr-namespace:ControlUI.Main.UI.Units">

    <Style TargetType="{x:Type views:MainContent}">
        <Setter Property="CurrentPageKey" Value="{Binding CurrentPageKey}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MainContent}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <units:SideBarView
                                Grid.Column="0"
                                ItemsSource="{Binding Menus}"
                                SelectedItem="{Binding SelectedMenu, Mode=TwoWay}"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource ContentBackgroundBrush}">
                                <ContentControl Content="{TemplateBinding PageContent}"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
