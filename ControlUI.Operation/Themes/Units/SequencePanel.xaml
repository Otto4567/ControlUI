<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:units="clr-namespace:ControlUI.Operation.UI.Units">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ControlUI.Operation;component/Themes/OperationStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type units:SequencePanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:SequencePanel}">
                    <Border Style="{StaticResource OperationCard}">
                        <ScrollViewer CanContentScroll="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid MinWidth="520">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sequence" Style="{StaticResource OperationHeading}" />
                                <Button Grid.Column="1" Grid.RowSpan="2" Content="Select Sequence" Style="{StaticResource OperationButton}" IsEnabled="False" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Text="No sequence selected" Foreground="#E4E7EB" FontSize="22" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                                    <TextBlock Text="Repeat  —" Style="{StaticResource OperationMuted}" Margin="0,0,40,0" />
                                    <TextBlock Text="Completed  —" Style="{StaticResource OperationMuted}" Margin="0,0,40,0" />
                                    <TextBlock Text="Current action: Idle" Style="{StaticResource OperationMuted}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>