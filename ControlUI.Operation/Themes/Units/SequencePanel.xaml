<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:ControlUI.Support.Local.Models;assembly=ControlUI.Support" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:units="clr-namespace:ControlUI.Operation.UI.Units">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ControlUI.Operation;component/Themes/OperationStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type units:SequencePanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:SequencePanel}">
                    <Border Style="{StaticResource OperationCard}">
                        <ScrollViewer CanContentScroll="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid MinWidth="520">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource TextProject}" Style="{StaticResource OperationHeading}" />
                                <ComboBox Grid.Row="1" Width="320" HorizontalAlignment="Left"
                                          ToolTip="{DynamicResource TextSelectProject}"
                                          ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSequenceRunning}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                    <StackPanel Width="130" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource TextRunMode}"/>
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedProject.RunMode, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource TextRunOnce}" Tag="{x:Static models:ProjectRunMode.Once}"/>
                                            <ComboBoxItem Content="{DynamicResource TextRunRepeat}" Tag="{x:Static models:ProjectRunMode.Repeat}"/>
                                            <ComboBoxItem Content="{DynamicResource TextRunContinuous}" Tag="{x:Static models:ProjectRunMode.Continuous}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,14,0">
                                        <TextBlock Text="{DynamicResource TextRepeatCount}"/>
                                        <hc:NumericUpDown Minimum="1" Maximum="2147483647" Increment="1" IsEnabled="{Binding SelectedProject.IsRepeatMode, FallbackValue=False}"
                                                          Value="{Binding SelectedProject.RepeatCount, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{DynamicResource TextCompleted}"/>
                                        <TextBlock Text="{Binding CompletedCycles}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Grid.Column="1" Grid.RowSpan="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StepProgress}" Margin="12,0,0,0"/>
                                        <TextBlock Text="{DynamicResource TextStepProgress}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <ProgressBar Height="8" Minimum="0" Maximum="{Binding StepCount}"
                                                 Value="{Binding CompletedSteps, Mode=OneWay}"
                                                 AutomationProperties.Name="{DynamicResource TextStepProgress}"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"
                                                   Text="{Binding StepElapsedTime, TargetNullValue=—}"/>
                                        <TextBlock Text="{Binding CurrentStep, TargetNullValue=—}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentStep}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
