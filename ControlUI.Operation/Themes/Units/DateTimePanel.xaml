<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:units="clr-namespace:ControlUI.Operation.UI.Units">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ControlUI.Operation;component/Themes/OperationStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type units:DateTimePanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:DateTimePanel}">
                    <Border Style="{StaticResource OperationCard}">
                        <ScrollViewer CanContentScroll="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid MinWidth="200">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Date &amp; Time" Style="{StaticResource OperationHeading}" />
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding DateText}" Foreground="#B9C0CA" FontSize="18" HorizontalAlignment="Center" />
                                    <Viewbox Height="42" StretchDirection="DownOnly" Margin="0,4,0,0">
                                        <hc:FlipClock />
                                    </Viewbox>
                                </StackPanel>
                                <TextBlock Text="Elapsed  —    ·    Last cycle  —" Style="{StaticResource OperationMuted}" Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Center" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>