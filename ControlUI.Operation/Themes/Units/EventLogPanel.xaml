<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:units="clr-namespace:ControlUI.Operation.UI.Units">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ControlUI.Operation;component/Themes/OperationStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="{x:Type units:EventLogPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type units:EventLogPanel}">
                    <Border Style="{StaticResource OperationCard}">
                        <ScrollViewer CanContentScroll="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid MinWidth="340">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Event Log" Style="{StaticResource OperationHeading}" />
                                <Border Grid.Row="1" BorderBrush="#3B3F45" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Time" Style="{StaticResource OperationMuted}" />
                                        <TextBlock Text="Level" Style="{StaticResource OperationMuted}" Grid.Column="1" />
                                        <TextBlock Text="Message" Style="{StaticResource OperationMuted}" Grid.Column="2" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="No events yet" Style="{StaticResource OperationText}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Device events will appear here." Style="{StaticResource OperationMuted}" Margin="0,8,0,0" />
                                </StackPanel>
                                <TextBlock Text="0 events" Style="{StaticResource OperationMuted}" Grid.Row="3" Margin="0,12,0,0" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>