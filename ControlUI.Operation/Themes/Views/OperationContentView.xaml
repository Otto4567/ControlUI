<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:ControlUI.Operation.UI.Views"
    xmlns:units="clr-namespace:ControlUI.Operation.UI.Units">

    <Style TargetType="{x:Type views:OperationContentView}">
        <Setter Property="Background" Value="#181A1C"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:OperationContentView}">
                    <Border Background="{TemplateBinding Background}">
                        <Grid Margin="12" ClipToBounds="True" UseLayoutRounding="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.1*"/>
                                <RowDefinition Height="0.75*"/>
                                <RowDefinition Height="1.15*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <units:DeviceStatusPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,12"/>
                            <units:DateTimePanel Grid.Row="0" Grid.Column="1" Margin="6,0,6,12"/>
                            <units:SystemStatusPanel Grid.Row="0" Grid.Column="2" Margin="6,0,0,12"/>
                            <units:SequencePanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12"/>
                            <units:EventLogPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,6,0"/>
                            <units:OperationControlPanel Grid.Row="2" Grid.Column="2" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
