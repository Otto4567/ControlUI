<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="OperationCard" TargetType="Border">
        <Setter Property="Background" Value="#242628"/>
        <Setter Property="BorderBrush" Value="#34373B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="OperationText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#E4E7EB"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="OperationHeading" TargetType="TextBlock" BasedOn="{StaticResource OperationText}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="OperationMuted" TargetType="TextBlock" BasedOn="{StaticResource OperationText}">
        <Setter Property="Foreground" Value="#989FA8"/>
    </Style>
    <Style x:Key="OperationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Foreground" Value="#E4E7EB"/>
        <Setter Property="Background" Value="#343A42"/>
        <Setter Property="BorderBrush" Value="#4A515B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MinHeight" Value="42"/>
    </Style>
</ResourceDictionary>